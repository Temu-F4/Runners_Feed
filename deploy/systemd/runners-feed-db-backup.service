[Unit]
Description=Back up Runners Feed PostgreSQL to OCI Object Storage
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=github-deploy
Group=github-deploy
SupplementaryGroups=docker
Environment=RUNNERS_FEED_PROJECT_DIR=/opt/runners-feed/current
Environment=RUNNERS_FEED_ENV_FILE=/etc/runners-feed/prod.env
Environment=RUNNERS_FEED_DEPLOY_STATE_DIR=/var/lib/runners-feed-cd
WorkingDirectory=/opt/runners-feed/current
ExecStart=/opt/runners-feed/current/deploy/run_database_backup.sh
