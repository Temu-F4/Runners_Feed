[Unit]
Description=Back up Runners Feed PostgreSQL to OCI Object Storage
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/home/ubuntu/runners-feed-poc-deploy
ExecStart=/home/ubuntu/runners-feed-poc-deploy/deploy/run_database_backup.sh
