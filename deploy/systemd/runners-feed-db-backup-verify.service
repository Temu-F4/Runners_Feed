[Unit]
Description=Restore and verify the latest Runners Feed PostgreSQL backup
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/home/ubuntu/runners-feed-poc-deploy
ExecStart=/home/ubuntu/runners-feed-poc-deploy/deploy/verify_database_backup.sh
