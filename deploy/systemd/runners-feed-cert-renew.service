[Unit]
Description=Renew the Runners Feed IP certificate
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=github-deploy
Group=github-deploy
SupplementaryGroups=docker
Environment=RUNNERS_FEED_PROJECT_DIR=/opt/runners-feed/current
Environment=RUNNERS_FEED_ENV_FILE=/etc/runners-feed/prod.env
WorkingDirectory=/opt/runners-feed/current
ExecStart=/opt/runners-feed/current/deploy/renew_ip_certificate.sh
