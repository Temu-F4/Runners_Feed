POSTGRES_DB=runners_feed
POSTGRES_USER=runners_feed
POSTGRES_PASSWORD=change-me
API_KEY=replace-with-a-long-random-secret
# Local default is ./runtime.
# OCI uses /home/ubuntu/runners-feed-runtime.
RUNNERS_FEED_RUNTIME_DIR=./runtime

# Container user for mounted OCI/runtime files.
# Set these to the host user's numeric UID and GID on OCI.
INFERENCE_UID=1000
INFERENCE_GID=1000

# Result video URLs expire after 15 minutes by default.
RESULT_URL_TTL_SECONDS=900
OCI_OBJECT_STORAGE_PUBLIC_ENDPOINT=https://objectstorage.ap-seoul-1.oraclecloud.com

# Direct video upload URLs expire after 15 minutes.
# The default maximum upload size is 250 MiB.
UPLOAD_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=262144000

# Optional AI narrative report through Ollama Cloud.
# Keep the real API key only in the deployment .env file.
LLM_REPORT_ENABLED=false
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_REPORT_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT_SECONDS=90

# Vector RAG through PostgreSQL pgvector and a local Ollama embedding model.
# Run the explicit corpus ingestion command before enabling this flag.
VECTOR_RAG_ENABLED=false
OLLAMA_EMBEDDING_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
