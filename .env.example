POSTGRES_DB=runners_feed
POSTGRES_USER=runners_feed
POSTGRES_PASSWORD=change-me
API_KEY=replace-with-a-long-random-secret
# Local default is ./runtime.
# OCI uses /home/ubuntu/runners-feed-runtime.
RUNNERS_FEED_RUNTIME_DIR=./runtime

# Container user for mounted OCI/runtime files.
# Set these to the host user's numeric UID and GID on OCI.
COACH_UID=1000
COACH_GID=1000

# Result video URLs expire after 15 minutes by default.
RESULT_URL_TTL_SECONDS=900
OCI_OBJECT_STORAGE_PUBLIC_ENDPOINT=https://objectstorage.ap-seoul-1.oraclecloud.com

# Direct video upload URLs expire after 15 minutes.
# The default maximum upload size is 250 MiB.
UPLOAD_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=262144000
GUEST_SESSION_TTL_DAYS=365
INACTIVE_GUEST_TTL_DAYS=365
TRANSIENT_ARTIFACT_TTL_HOURS=24
FAILED_RUN_TTL_HOURS=48
MAINTENANCE_INTERVAL_SECONDS=21600
MAINTENANCE_BATCH_SIZE=100

# PostgreSQL backups are stored in a separate private OCI bucket.
OCI_BACKUP_BUCKET=bucket-t04-backups
DB_BACKUP_RETENTION_DAYS=30

# Coach worker. `auto` runs the Agent only when OPENAI_API_KEY is present.
COACH_DEVICE=cpu
COACH_AGENT_ENABLED=auto
COACH_TIMEOUT_SECONDS=3600
OPENAI_API_KEY=

# Grafana is served through the existing HTTPS endpoint at /grafana/.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-secret
GRAFANA_ROOT_URL=https://140.238.0.197/grafana/
GRAFANA_POSTGRES_PASSWORD=replace-with-a-separate-read-only-secret
