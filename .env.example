POSTGRES_DB=runners_feed
POSTGRES_USER=runners_feed
POSTGRES_PASSWORD=change-me
API_KEY=replace-with-a-long-random-secret
# Local default is ./runtime.
# OCI uses /home/ubuntu/runners-feed-runtime.
RUNNERS_FEED_RUNTIME_DIR=./runtime

# Local builds use runners-feed-<service>:local. Production overrides these
# with the private GHCR prefix and an immutable sha-<commit> tag.
IMAGE_PREFIX=runners-feed
IMAGE_TAG=local

# Container user for mounted OCI/runtime files.
# Set these to the host user's numeric UID and GID on OCI.
COACH_UID=1000
COACH_GID=1000

# Result video URLs expire after 15 minutes by default.
RESULT_URL_TTL_SECONDS=900
OCI_OBJECT_STORAGE_PUBLIC_ENDPOINT=https://objectstorage.ap-seoul-1.oraclecloud.com

# Direct video upload URLs expire after 15 minutes.
# The default maximum upload size is 250 MiB.
UPLOAD_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=262144000
GUEST_SESSION_TTL_DAYS=365
ACCOUNT_SESSION_TTL_DAYS=30
# Deployment verification returns rollback_required when these runtime guards fail.
MODEL_QUALITY_WINDOW_MINUTES=60
MODEL_QUALITY_MIN_SAMPLE_SIZE=3
MODEL_QUALITY_MAX_PROCESSING_SECONDS=3600
MODEL_QUALITY_MIN_SUCCESS_RATE=0.95
MODEL_QUALITY_MAX_FAILURE_RATE=0.10
# Kakao Developers > My Application > App keys > REST API key.
KAKAO_REST_API_KEY=
# Optional, but required when Client secret is enabled in Kakao Developers.
KAKAO_CLIENT_SECRET=
# Register this exact URI in Kakao Developers > Kakao Login > Redirect URI.
KAKAO_REDIRECT_URI=https://your-production-host/api/auth/kakao/callback
# Register this separate HTTPS URI for the Expo system-browser flow.
KAKAO_MOBILE_REDIRECT_URI=https://your-production-host/api/mobile/v1/auth/kakao/callback
# Fixed native deep link configured in app.json/app.config.ts.
MOBILE_APP_REDIRECT_URI=runnersfeed://auth/callback
INACTIVE_GUEST_TTL_DAYS=365
TRANSIENT_ARTIFACT_TTL_HOURS=24
FAILED_RUN_TTL_HOURS=48
MAINTENANCE_INTERVAL_SECONDS=21600
MAINTENANCE_BATCH_SIZE=100

# PostgreSQL backups share the private results bucket under backups/postgres/.
OCI_BACKUP_BUCKET=bucket-t04-results
DB_BACKUP_RETENTION_DAYS=30

# Coach worker. `auto` runs the Agent only when OPENAI_API_KEY is present.
COACH_DEVICE=cpu
COACH_MODEL_ID=sehyeon-e2fe43e
MODEL_CANARY_REQUIRED=1
MODEL_GOLDEN_DIR=/opt/runners-feed/model-golden/sehyeon-e2fe43e
MODEL_QUALITY_WATCHDOG_SECONDS=3600
COACH_AGENT_ENABLED=auto
# Optional text-generation model for the coaching narrative only.
# Pose and feature calculations do not depend on this setting.
COACH_LLM_MODEL=gpt-5.6-luna
COACH_TIMEOUT_SECONDS=3600
OPENAI_API_KEY=

# Grafana is served through the existing HTTPS endpoint at /grafana/.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-secret
GRAFANA_ROOT_URL=https://140.238.0.197/grafana/
GRAFANA_POSTGRES_PASSWORD=replace-with-a-separate-read-only-secret
# Production uses /etc/runners-feed/secrets/slack_webhook_url.
ALERTMANAGER_SLACK_WEBHOOK_FILE=./monitoring/alertmanager/slack_webhook_url.example
# Keep unvalidated measurements, AI coaching, and evidence hidden in external beta builds.
NEXT_PUBLIC_SHOW_INTERNAL_RESULTS=0
# RunPod GPU video_analysis dispatcher (OCI worker only; keep token secret)
RUNPOD_VIDEO_ANALYSIS_ENDPOINT=
RUNPOD_SHARED_TOKEN=
RUNPOD_REQUEST_TIMEOUT=3700
RUNPOD_SIGNED_URL_TTL_SECONDS=7200
GPU_ATTEMPT_STALE_SECONDS=4200
POSTPROCESS_ATTEMPT_STALE_SECONDS=1200
COACH_POSTPROCESS_TIMEOUT_SECONDS=900
