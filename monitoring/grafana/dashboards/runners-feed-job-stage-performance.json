      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "runners-feed-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH selected AS (SELECT * FROM inference_jobs WHERE job_id = NULLIF('${job_id}', '')::uuid), bounds AS (SELECT min(started_at) AS first_stage_at, max(coalesce(completed_at, now())) FILTER (WHERE status NOT IN ('PENDING', 'SKIPPED')) AS last_stage_at, sum(coalesce(duration_seconds, 0)) AS measured_stage_seconds, sum(coalesce(duration_seconds, 0)) FILTER (WHERE stage_key <> 'workspace_cleanup') AS measured_processing_seconds FROM inference_job_stages WHERE job_id = NULLIF('${job_id}', '')::uuid) SELECT extract(epoch FROM selected.started_at - selected.created_at) AS queue_seconds, extract(epoch FROM coalesce(selected.completed_at, now()) - selected.started_at) AS processing_seconds, coalesce(extract(epoch FROM bounds.last_stage_at - bounds.first_stage_at), extract(epoch FROM coalesce(selected.completed_at, now()) - selected.started_at)) AS worker_active_seconds, bounds.measured_stage_seconds, greatest(extract(epoch FROM coalesce(selected.completed_at, now()) - selected.started_at) - coalesce(bounds.measured_processing_seconds, extract(epoch FROM coalesce(selected.completed_at, now()) - selected.started_at)), 0) AS unattributed_seconds FROM selected CROSS JOIN bounds",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          }
        }
