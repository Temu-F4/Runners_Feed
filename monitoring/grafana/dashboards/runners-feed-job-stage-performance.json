          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE stage_key WHEN 'input_download' THEN '1. 입력 다운로드' WHEN 'frame_extract' THEN '2. 프레임 추출' WHEN 'pose_inference' THEN '3. 자세 추론' WHEN 'report_generate' THEN '4. 리포트 생성' WHEN 'frame_render' THEN '5. 프레임 렌더링' WHEN 'video_compose' THEN '6. 영상 합성' WHEN 'video_encode' THEN '7. 최종 인코딩' WHEN 'result_upload' THEN '8. 결과 업로드' WHEN 'workspace_cleanup' THEN '9. 작업 폴더 정리' END AS stage, CASE WHEN status = 'RUNNING' THEN extract(epoch FROM now() - started_at) ELSE coalesce(duration_seconds, 0) END AS duration_seconds FROM inference_job_stages WHERE job_id = '${job_id}'::uuid ORDER BY stage_order",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          }
        }
      ],
      "title": "선택한 Job의 9단계 처리시간 (막대 1개 = 단계 1개)",
